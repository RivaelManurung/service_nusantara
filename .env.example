# Copy to .env and fill in real values. Never commit .env.

# --- application -------------------------------------------------------
APP_NAME=nusantara-service
APP_ENV=development           # development | staging | production
APP_VERSION=dev

# --- http --------------------------------------------------------------
PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=2097152
# Comma separated. Required in production and must not be "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Enable only when the service really sits behind a proxy you control,
# otherwise clients can forge the IP the rate limiter keys on.
HTTP_TRUST_PROXY_HEADERS=false

# --- postgres ----------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nusantara?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m
DB_SLOW_QUERY_THRESHOLD=300ms
# Development convenience only; rejected when APP_ENV=production.
DB_AUTO_MIGRATE=true

# --- redis -------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# --- auth --------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ISSUER=nusantara-service
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
BCRYPT_COST=12

# --- sign in with Google / Apple ---------------------------------------
# Comma separated client IDs this backend accepts. One per platform is normal.
# Leaving a list empty DISABLES that provider; it never means "accept any".
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
OIDC_HTTP_TIMEOUT=10s
OIDC_JWKS_CACHE_TTL=1h

# --- phone / OTP sign-in -----------------------------------------------
OTP_ENABLED=true
OTP_LENGTH=6
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
# "log" prints the code instead of sending it. Development only; production
# refuses to start with it.
OTP_SENDER=log
PHONE_DEFAULT_COUNTRY_CODE=62

# Role granted to self-service sign-ups (Google, Apple, phone). Must exist.
DEFAULT_SIGNUP_ROLE=customer

# --- image storage (Cloudinary) -----------------------------------------
# REQUIRED for any endpoint that accepts an image: type products, products,
# shops, banners, cashiers, events. Leave them empty and the service still
# starts, but every upload answers 503 "image uploads are not configured on
# this server" and logs "image uploads disabled" once at startup.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Namespaces assets so one account can serve several environments.
CLOUDINARY_ROOT_FOLDER=nusantara
CLOUDINARY_TIMEOUT=30s

# --- rate limiting -----------------------------------------------------
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_WINDOW=15m

# --- logging -----------------------------------------------------------
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=json               # json | text
